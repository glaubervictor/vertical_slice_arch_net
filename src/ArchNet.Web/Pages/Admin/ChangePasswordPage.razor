@page "/admin/users/{UserId}/change-password"
@attribute [Authorize]
@inject IArchNetClient Client
@inject NavigationManager Navigation

<PageTitle>Alterar Senha — ArchNet</PageTitle>

<div class="flex flex-col gap-6 max-w-lg">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Alterar Senha</h1>
        <p class="text-muted-foreground text-sm">Defina uma nova senha para o usuário.</p>
    </div>

    <BbCard>
        <BbCardContent Class="pt-6">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <BbAlert Variant="AlertVariant.Danger" Class="mb-4">
                    <BbAlertTitle>Erro</BbAlertTitle>
                    <BbAlertDescription>@_errorMessage</BbAlertDescription>
                </BbAlert>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <BbAlert Class="mb-4">
                    <BbAlertTitle>Sucesso</BbAlertTitle>
                    <BbAlertDescription>@_successMessage</BbAlertDescription>
                </BbAlert>
            }

            <div class="flex flex-col gap-4">
                <BbFormFieldInput TValue="string"
                                  @bind-Value="_currentPassword"
                                  Label="Senha Atual"
                                  Type="InputType.Password"
                                  Placeholder="••••••••"
                                  Required="true" />

                <BbFormFieldInput TValue="string"
                                  @bind-Value="_newPassword"
                                  Label="Nova Senha"
                                  Type="InputType.Password"
                                  Placeholder="••••••••"
                                  Required="true" />

                <BbFormFieldInput TValue="string"
                                  @bind-Value="_confirmPassword"
                                  Label="Confirmar Nova Senha"
                                  Type="InputType.Password"
                                  Placeholder="••••••••"
                                  Required="true" />
            </div>
        </BbCardContent>
        <BbCardFooter Class="gap-2">
            <BbButton Variant="ButtonVariant.Outline" Href="/admin/users">
                Cancelar
            </BbButton>
            <BbButton Type="ButtonType.Button"
                      Loading="_loading"
                      LoadingText="Salvando..."
                      OnClick="HandleChangePassword">
                Salvar Senha
            </BbButton>
        </BbCardFooter>
    </BbCard>
</div>

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _loading;
    private string? _errorMessage;
    private string? _successMessage;

    private async Task HandleChangePassword()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword)
            || string.IsNullOrWhiteSpace(_newPassword)
            || string.IsNullOrWhiteSpace(_confirmPassword))
        {
            _errorMessage = "Preencha todos os campos.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "A nova senha e a confirmação não coincidem.";
            return;
        }

        _loading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var result = await Client.ChangePassword.ExecuteAsync(
                new ChangePasswordInput
                {
                    UserId = UserId,
                    CurrentPassword = _currentPassword,
                    NewPassword = _newPassword
                });

            if (result.IsErrorResult())
            {
                _errorMessage = result.Errors.FirstOrDefault()?.Message
                    ?? "Erro ao alterar a senha.";
                return;
            }

            _successMessage = "Senha alterada com sucesso.";
            _currentPassword = string.Empty;
            _newPassword = string.Empty;
            _confirmPassword = string.Empty;
        }
        catch
        {
            _errorMessage = "Não foi possível alterar a senha.";
        }
        finally
        {
            _loading = false;
        }
    }
}
